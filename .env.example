# =====================================================================
# CyberJobs Ontario — environment configuration
#
# Copy to .env.local for local development, or paste into the Vercel
# project's Environment Variables screen for production.
#
# The app runs with NONE of these set: it falls back to a local JSON
# store and the API sources that need no key. Set Supabase + CRON_SECRET
# for a real deployment.
# =====================================================================

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CyberJobs Ontario"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# Database (Supabase) — required for durable storage in production
# Project settings -> API. Run supabase/schema.sql first.
# ---------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Only needed if you also want client-side reads:
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------
# Scheduled refresh
# Any long random string. Required to call /api/cron/ingest in production.
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-app/api/cron/ingest
# Vercel Cron invocations are authorised automatically.
# ---------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------
# Crawler identity — good-citizen practice. Point this at your repo or
# an email address so site operators can reach you.
# ---------------------------------------------------------------------
CRAWLER_CONTACT="https://github.com/Roshan-Dennis/cyberjobs-ontario"
# CRAWLER_USER_AGENT="CyberJobsOntarioBot/1.0 (+https://example.com/bot)"

# ---------------------------------------------------------------------
# Ingestion tuning
# ---------------------------------------------------------------------
# Wall-clock budget per run, in ms. Keep under your platform's function limit.
INGEST_MAX_DURATION_MS="240000"
# Ceiling for any single source, so one slow source cannot starve the rest.
INGEST_MAX_SOURCE_MS="90000"
INGEST_CONCURRENCY="4"
# 0-100. Postings scoring below this are discarded.
INGEST_MIN_RELEVANCE="25"
# Include help desk / NOC / sysadmin roles as "pathway into cyber".
INGEST_INCLUDE_PATHWAY="true"
# Include remote roles open to anywhere in Canada, not just Ontario.
INGEST_ALLOW_REMOTE_CANADA="true"
# Postings older than this many days are marked expired.
INGEST_EXPIRY_DAYS="60"
# Comma-separated allow-list / deny-list of source ids. Empty = all.
INGEST_SOURCES=""
INGEST_DISABLED_SOURCES=""

# Add your own ATS boards without touching the code.
# Greenhouse token = the slug in boards.greenhouse.io/<token>
EXTRA_GREENHOUSE_BOARDS=""
EXTRA_LEVER_BOARDS=""
EXTRA_ASHBY_BOARDS=""
EXTRA_WORKABLE_BOARDS=""
EXTRA_RECRUITEE_BOARDS=""
EXTRA_SMARTRECRUITERS_BOARDS=""

# ---------------------------------------------------------------------
# Job Bank (Government of Canada)
# robots.txt allows crawling with Crawl-delay: 5 — do not lower this.
# ---------------------------------------------------------------------
JOBBANK_ENABLED="true"
JOBBANK_CRAWL_DELAY_MS="5000"
JOBBANK_MAX_PAGES="2"
# NOTE: Job Bank keyword queries must be SINGLE words. A multi-word value is
# reinterpreted as an employer name and returns zero results.
JOBBANK_MAX_QUERIES="16"
# Fetching full descriptions costs 5s per posting. Off by default.
JOBBANK_FETCH_DETAILS="false"

# ---------------------------------------------------------------------
# Optional licensed aggregators (free developer tiers)
# ---------------------------------------------------------------------
# https://developer.adzuna.com — free registration
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_MAX_PAGES="3"

# https://jooble.org/api/about — free key on request
JOOBLE_API_KEY=""

# ---------------------------------------------------------------------
# Opt-in sources
# These sites' robots.txt currently disallows automated access. Enable
# ONLY if you have permission from the operator.
# ---------------------------------------------------------------------
ENABLE_SMARTRECRUITERS="false"
ENABLE_REMOTIVE="false"

# ---------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------
SEARCH_CACHE_TTL="60"
MEMORY_REFRESH_TTL="1800"

# Where the no-database fallback store writes its JSON snapshot.
# DATA_DIR="./data"
