{
  "name": "cyberjobs-ontario",
  "version": "1.0.0",
  "private": true,
  "description": "Live cybersecurity job aggregator for Ontario and remote-Canada roles.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:dry": "tsx scripts/ingest.ts --dry-run",
    "sources": "tsx scripts/list-sources.ts",
    "selftest": "tsx scripts/selftest.ts",
    "data": "tsx scripts/build-data.ts",
    "build:static": "STATIC_EXPORT=1 next build",
    "publish": "npm run data && npm run build:static",
    "fixture": "tsx scripts/fixture-data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cheerio": "^1.0.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
